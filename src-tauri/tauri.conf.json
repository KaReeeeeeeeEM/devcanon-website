{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Devcanon Studio",
  "version": "0.1.0",
  "identifier": "dev.devcanon.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000/studio",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [{ "title": "Devcanon Studio", "url": "studio/index.html", "width": 1240, "height": 820, "minWidth": 820, "minHeight": 620 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; connect-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Create portable devcanon presets visually."
  }
}
